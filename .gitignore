# =============================================================================
# Unity .gitignore (Unity 6 / GolfBomber)
# =============================================================================

# Unity-generated folders that should never be committed --------------------
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
.utmp/

# Asset Bundles & Addressables ---------------------------------------------
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Visual Studio / Rider / VS Code project files (Unity regenerates these) ---
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.unitypackage
.vsconfig

# Builds --------------------------------------------------------------------
*.apk
*.aab
*.app
*.ipa
*.exe

# Crash logs ---------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties

# OS junk -------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Backup / local-only files ------------------------------------------------
*.bak
*.swp
*~
